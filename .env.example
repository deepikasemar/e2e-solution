# Optional. Without a key, drafts are written from the verified profile by a template.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# tfidf (default) or sentence-transformers
SEMANTIC_BACKEND=tfidf
SENTENCE_MODEL=all-MiniLM-L6-v2

DAILY_LIMIT=8
SECRET_KEY=change-me
DATABASE_PATH=var/applyagent.sqlite
PORT=43123
